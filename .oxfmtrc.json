{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "useTabs": false,
  "bracketSpacing": false,
  "bracketSameLine": false,
  "arrowParens": "always",
  "semi": true,
  "trailingComma": "all",
  "singleQuote": true,
  "jsxSingleQuote": true,
  "quoteProps": "as-needed",
  "ignorePatterns": ["next-env.d.ts"]
}
